# Teamwork
TEAMWORK_SITE_URL=https://projects.example.com
TEAMWORK_API_TOKEN=

# Slack — bot token (xoxb-...) with chat:write, users:read, users:read.email
# App-Level Token (xapp-) — Socket Mode only, powers the Mute buttons
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# Server
PORT=4310
DATA_DIR=./data

# Optional per-person Slack user tokens (xoxp-) for mention search.
# One per recipient id, upper-cased, non-alphanumerics as underscores:
#   recipient "alex-kim"  ->  SLACK_USER_TOKEN_ALEX_KIM
# These can also be pasted in the dashboard; the environment wins when both are set.
# SLACK_USER_TOKEN_EXAMPLE=

# Gemini — writes the standup summary at the end of the evening digest
GEMINI_API_KEY=

# Set this on any host where the dashboard port is publicly reachable (e.g. Render).
# Not needed locally, where the port is bound to loopback.
DASHBOARD_PASSWORD=
