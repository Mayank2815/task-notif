{
  "name": "task-notif",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.json && npm --prefix dashboard run build",
    "probe": "tsx src/cli/probe.ts",
    "dry-run": "tsx src/cli/dry-run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "send-now": "tsx src/cli/send-now.ts",
    "digest-preview": "tsx src/cli/digest-preview.ts",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "luxon": "^3.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
